<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Pipeline Command Center</masterLabel>
    <description>Daily command center for sales managers: pipeline health, risk, list and Kanban views, inline updates and live team activity.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="cardTitle" type="String" label="Title" default="Pipeline Command Center" />
            <property
                name="highValueThreshold"
                type="Integer"
                label="High value threshold"
                description="Deals at or above this amount are marked as high value."
                default="100000"
                min="0"
            />
            <property
                name="staleDays"
                type="Integer"
                label="Stale after (days)"
                description="Days without activity before a deal is flagged as stale."
                default="14"
                min="1"
                max="365"
            />
            <property
                name="defaultView"
                type="String"
                label="Default view"
                datasource="list,kanban"
                default="list"
            />
            <property
                name="defaultScope"
                type="String"
                label="Default scope"
                datasource="TEAM,MINE,ALL"
                default="TEAM"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
